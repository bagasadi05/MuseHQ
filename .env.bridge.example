# =============================================================
# MuseHQ External Peer Bridge Configuration
# Salin file ini menjadi `.env.bridge` (otomatis di-ignore oleh git!)
# lalu isi token dan opsi AI / Upstream bot asli Anda.
# =============================================================

# URL WebSocket External Bridge MuseHQ (Render / Lokal / VPS)
MUSE_WS_URL=wss://musehq.onrender.com/ws/bot

# Token rahasia BOT_BRIDGE_TOKEN (HARUS sama dengan yang Anda isi di Render)
BOT_BRIDGE_TOKEN=

# -------------------------------------------------------------
# OPSIONAL 1: Hubungkan ke AI Sungguhan (Gemini / OpenAI / Anthropic)
# Jika salah satu API key di bawah diisi, keempat bot memakai AI nyata
# saat mengerjakan tugas atau diajak ngobrol (kosongkan untuk mode Bridge standar).
# -------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# -------------------------------------------------------------
# OPSIONAL 2: Hubungkan ke Aplikasi / Server Bot Terpisah (per bot)
# Jika bot Muse milik Bagas/Arif/Niro/Joni sudah jalan terpisah
# (mis. OpenClaw /v1/chat/completions, Python FastAPI, n8n Webhook, dll.),
# isi URL endpoint-nya di bawah. Format "auto" otomatis mendeteksi
# endpoint `/chat/completions` atau webhook JSON standar `{ event, payload }`.
# -------------------------------------------------------------
MUSE_BAGAS_UPSTREAM_URL=
MUSE_BAGAS_UPSTREAM_TOKEN=
MUSE_BAGAS_UPSTREAM_FORMAT=auto

MUSE_ARIF_UPSTREAM_URL=
MUSE_ARIF_UPSTREAM_TOKEN=
MUSE_ARIF_UPSTREAM_FORMAT=auto

MUSE_NIRO_UPSTREAM_URL=
MUSE_NIRO_UPSTREAM_TOKEN=
MUSE_NIRO_UPSTREAM_FORMAT=auto

MUSE_JONI_UPSTREAM_URL=
MUSE_JONI_UPSTREAM_TOKEN=
MUSE_JONI_UPSTREAM_FORMAT=auto
