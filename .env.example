# Server configuration
PORT=3001
BOT_BRIDGE_TOKEN=muse-bridge-secret-dev

# Default AI Provider: demo | gemini | openai | anthropic
DEFAULT_PROVIDER=demo

# Cloud LLM API Keys (optional - leave blank to use Demo Mode or configure in the web UI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
