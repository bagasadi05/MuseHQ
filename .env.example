# =============================================================
# MuseHQ Server Configuration
# Salin ke .env atau server/.env (JANGAN commit file .env asli)
# =============================================================

PORT=3001

# Token rahasia untuk autentikasi bot eksternal (/ws/bot & /api/bridge/*)
# Kosongkan pada run lokal pertama agar server membuat token acak di server/data/settings.json,
# lalu salin ke sini atau atur di Environment Variables saat deploy.
BOT_BRIDGE_TOKEN=

# Passcode pemilik untuk membuka UI web MuseHQ & mengelola misi
# Wajib diatur saat deploy serverless/Vercel (sensitif!).
MUSE_OWNER_PASSCODE=

# Secret HMAC untuk cookie sesi owner (opsional di lokal; disarankan saat produksi)
SESSION_SECRET=

# Daftar origin yang diizinkan oleh CORS (pisahkan dengan koma).
# Contoh lokal + domain produksi:
# ALLOWED_ORIGINS=http://localhost:5173,https://musehq.vercel.app
ALLOWED_ORIGINS=

# Default AI Provider untuk bot Built-in Cloud LLM: gemini | openai | anthropic
# (Opsional jika hanya menggunakan bot External Bridge)
DEFAULT_PROVIDER=gemini

# Cloud LLM API Keys (isi sesuai provider yang dipakai bot Built-in, atau atur lewat Modal API Keys di UI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
