{
  "name": "muse-ai-hq",
  "version": "1.0.0",
  "private": true,
  "description": "MuseHQ — Multi-Agent Virtual Office & Orchestration Hub for Muse AI Bots",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install --include=optional --no-package-lock",
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "start": "npm --prefix server start",
    "example:bot": "node examples/external-bot.mjs",
    "example:rest-bot": "node examples/rest-polling-bot.mjs",
    "bridge:bot": "node examples/muse-peer-bridge.mjs",
    "bridge:team": "node examples/team-bridge.mjs"
  }
}
